{
  "name": "tracekit-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first observability and replay for AI coding agents",
  "license": "MIT",
  "author": "Tracekit Contributors",
  "homepage": "https://github.com/ANSHSINGH050404/Tracekit#readme",
  "bugs": {
    "url": "https://github.com/ANSHSINGH050404/Tracekit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANSHSINGH050404/Tracekit.git"
  },
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "tracekit": "node packages/cli/dist/bin.js",
    "clean": "rimraf \"packages/*/dist\" \"adapters/*/dist\" \"*.tsbuildinfo\" \"packages/*/*.tsbuildinfo\" \"adapters/*/*.tsbuildinfo\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@changesets/config": "^3.1.1",
    "@types/node": "^22.13.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.4.2"
}
